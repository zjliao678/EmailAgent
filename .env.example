# QQ Mail — IMAP / SMTP
IMAP_HOST=imap.qq.com
IMAP_PORT=993
IMAP_USER=your_address@qq.com
IMAP_PASSWORD=your_qq_auth_code

SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your_address@qq.com
SMTP_PASSWORD=your_qq_auth_code

# Database (PostgreSQL in production, SQLite for local dev)
DATABASE_URL=sqlite:///./email_agent.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Attachment size limit (bytes)
ATTACHMENT_MAX_BYTES=10485760
